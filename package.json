{
  "name": "personal-growth-memory",
  "version": "0.1.0-beta.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "growth-memory": "./dist/src/cli.js",
    "gmem": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle:cli": "esbuild src/cli.ts --bundle --platform=node --format=cjs --target=node24 --outfile=release/work/gmem.cjs",
    "build:binary": "node scripts/release/build-binary.mjs",
    "verify:binary": "node scripts/release/verify-binary.mjs",
    "package:binary": "node scripts/release/package-binary.mjs",
    "release:prepare": "npm run build && npm run build:binary -- --target darwin-arm64 && npm run verify:binary -- --target darwin-arm64",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:full-workflow": "npm run build && vitest run tests/cli/full-workflow.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:peer": "node scripts/release/verify-peer.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/x509": "3.1.0",
    "commander": "^15.0.0",
    "reflect-metadata": "0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "license": "GPL-3.0-only",
  "files": [
    "dist/src/",
    "dist/package.json",
    "src/",
    "scripts/release/",
    "plugins/growth-memory/",
    ".agents/plugins/marketplace.json",
    "tsconfig.json",
    "README.md",
    "QUICKSTART.md",
    "AGENT_INTEGRATION.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE_POLICY.md"
  ]
}
